# Copy to .env.local for local dev (optional — Vite's dev proxy in
# vite.config.js already forwards /api, /auth, /demo to localhost:8000,
# so you usually don't need this file locally).
#
# In production, set this in Vercel's dashboard under
# Project Settings -> Environment Variables:
#   VITE_API_URL=https://your-backend.up.railway.app
# (no trailing slash). This must be the exact Railway URL your backend
# is deployed at, over https.
VITE_API_URL=
